require("./adapter.js");

const wasmBindgen = require("./game_wasm.js");
const douyinHost = typeof GameGlobal !== "undefined" ? GameGlobal : globalThis;
const douyinBevy = douyinHost.DouyinBevy;

if (!douyinBevy) throw new Error("DouyinBevy adapter failed to initialize");
if (douyinBevy.prepareReload) douyinBevy.prepareReload();

function startBevy() {
  let splitRuntime = null;
  try {
    splitRuntime = require("./__wasm_split.js");
  } catch (_) {
    // A normal, unsplit package does not include the optional runtime.
  }

  if (!splitRuntime) {
    return douyinBevy.readPackageFile("game_wasm_bg.wasm")
      .then((bytes) => wasmBindgen({ module_or_path: bytes }));
  }

  const decoder = require("./brotli_decoder.js");
  return Promise.all([
    douyinBevy.readPackageFile("brotli_decoder_bg.wasm"),
    douyinBevy.readPackageFile("game_wasm_bg.wasm.br"),
  ]).then(([decoderBytes, compressedMain]) =>
    decoder({ module_or_path: decoderBytes }).then(() => {
      splitRuntime.configure({
        readFile: (path) => douyinBevy.readPackageFile(path),
        decompress: (bytes) => decoder.decompress(bytes),
        mainExports: () => wasmBindgen.initSync(),
      });
      return wasmBindgen({ module_or_path: decoder.decompress(compressedMain) });
    }),
  );
}

startBevy()
  .catch((error) => {
    console.error("Failed to start Bevy Wasm:", error);
    throw error;
  });
